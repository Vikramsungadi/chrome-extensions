{
  "manifest_version": 3,
  "name": "Theme Dev Toolkit for Shopify",
  "short_name": "Theme Dev Toolkit",
  "version": "2.4.0",
  "description": "Shortcuts for Shopify theme developers: preview links with QR, theme editor, admin, markets, section inspector and QA tools.",
  "minimum_chrome_version": "116",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-disabled16.png",
      "32": "icons/icon-disabled32.png",
      "48": "icons/icon-disabled48.png",
      "128": "icons/icon-disabled128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "declarativeContent",
    "offscreen"
  ],
  "commands": {
    "_execute_action": {
      "description": "Open the toolkit popup"
    },
    "copy-preview-link": {
      "description": "Copy preview link",
      "suggested_key": {
        "default": "Ctrl+Shift+Q",
        "mac": "MacCtrl+C"
      }
    },
    "open-theme-editor": {
      "description": "Open theme editor on this page",
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "MacCtrl+E"
      }
    },
    "open-admin": {
      "description": "Go to admin: press, then a letter (P products, O orders…)",
      "suggested_key": {
        "default": "Alt+A",
        "mac": "MacCtrl+A"
      }
    },
    "toggle-section-highlighter": {
      "description": "Toggle section inspector",
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "MacCtrl+I"
      }
    },
    "copy-market-links": {
      "description": "Copy preview links for every market"
    },
    "open-code-editor": {
      "description": "Open theme code editor"
    },
    "toggle-preview-bar": {
      "description": "Hide / show Shopify preview bar"
    },
    "copy-debug-info": {
      "description": "Copy store + theme + market debug info"
    }
  },
  "optional_host_permissions": [
    "https://*.myshopify.com/*",
    "https://admin.shopify.com/*",
    "https://*/*"
  ]
}
